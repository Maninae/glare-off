{
  "name": "Glare Off",
  "short_name": "Glare Off",
  "description": "Remove glare from glasses in photos. Runs on your device; nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f5f4ef",
